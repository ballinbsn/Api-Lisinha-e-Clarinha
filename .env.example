# Porta local (Railway define PORT automaticamente em produção)
PORT=8080

# Postgres — no Railway, adicione o plugin "Postgres" ao projeto e ele
# injeta DATABASE_URL sozinho. Localmente, aponte para um Postgres seu.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/popozuda

# Chaves da PinPay (Configurações -> Chaves de API no painel da PinPay).
# NUNCA commitar valores reais — preencha isso apenas nas variáveis de
# ambiente do Railway, nunca neste arquivo.
PINPAY_TOKEN=INSERIR_SK_LIVE_AQUI
PINPAY_WEBHOOK_SECRET=INSERIR_WHSEC_AQUI

# Origens do frontend autorizadas a chamar esta API (separadas por vírgula).
# Sem isso, o navegador bloqueia as chamadas por CORS.
FRONTEND_ORIGIN=https://seu-site.vercel.app,http://localhost:4321,http://127.0.0.1:4321

# URL pública deste backend depois de publicado no Railway (sem barra final).
# Usada para montar o webhook_url enviado à PinPay a cada cobrança.
PUBLIC_URL=https://seu-backend.up.railway.app
